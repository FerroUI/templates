<UserControl xmlns="https://github.com/ferroui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:{{project-name | pascal_case}}.ViewModels"
             x:Class="{{project-name | pascal_case}}.Views.MainView"
             x:DataType="vm:MainViewModel">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
    <TextBlock Text="{Binding Greeting}" FontSize="24" HorizontalAlignment="Center" />
    <Button Name="IncrementButton" Content="Click me" Command="{Binding Increment}" HorizontalAlignment="Center" />
    <TextBlock Name="CountText" Text="{Binding CountText}" HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
